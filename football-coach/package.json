{
  "name": "angry-andy-football-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Angry Andy - Football Coach: a small top-down pixel-art kids football coaching survival game for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "art": "node tools/make-placeholder-art.mjs",
    "smoke": "node tools/smoke.cjs",
    "package": "npm run build && node tools/package-single.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
